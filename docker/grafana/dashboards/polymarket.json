{
  "dashboard": {
    "id": null,
    "title": "Polymarket Trading",
    "timezone": "browser",
    "panels": [
      {
        "title": "Open Positions",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [
          {"expr": "polymarket_positions_open", "legendFormat": "positions"}
        ],
        "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5}, {"color": "red", "value": 10}]}}}
      },
      {
        "title": "Total Exposure (USD)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [
          {"expr": "polymarket_total_exposure_usd", "legendFormat": "exposure"}
        ],
        "fieldConfig": {"defaults": {"unit": "currencyUSD"}}
      },
      {
        "title": "Unrealized PnL (USD)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [
          {"expr": "polymarket_unrealized_pnl_usd", "legendFormat": "pnl"}
        ],
        "fieldConfig": {"defaults": {"unit": "currencyUSD", "color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 0}]}}}
      },
      {
        "title": "Trades Published",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {"expr": "rate(polymarket_trades_published_total[5m])", "legendFormat": "{{source}}"}
        ]
      },
      {
        "title": "Publish Timeouts",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {"expr": "rate(polymarket_publish_timeouts_total[5m])", "legendFormat": "{{source}}"}
        ]
      }
    ],
    "time": {"from": "now-1h", "to": "now"},
    "refresh": "10s"
  }
}
