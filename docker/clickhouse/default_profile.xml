<clickhouse>
    <profiles>
        <default>
            <!-- ── Memory ── -->
            <max_memory_usage>34359738368</max_memory_usage>                   <!-- 32 GB per query -->
            <max_memory_usage_for_user>51539607552</max_memory_usage_for_user> <!-- 48 GB per user -->

            <!-- ── Threading ── -->
            <max_threads>32</max_threads>
            <max_insert_threads>16</max_insert_threads>
            <max_download_threads>16</max_download_threads>

            <!-- ── I/O: NVMe-optimized ── -->
            <min_bytes_to_use_direct_io>1</min_bytes_to_use_direct_io>
            <max_read_buffer_size>1048576</max_read_buffer_size>
            <read_backoff_min_latency_ms>0</read_backoff_min_latency_ms>
            <merge_tree_min_rows_for_concurrent_read>0</merge_tree_min_rows_for_concurrent_read>
            <merge_tree_min_bytes_for_concurrent_read>0</merge_tree_min_bytes_for_concurrent_read>

            <!-- ── Query execution ── -->
            <use_uncompressed_cache>1</use_uncompressed_cache>
            <compile_expressions>1</compile_expressions>
            <min_count_to_compile_expression>3</min_count_to_compile_expression>
            <optimize_move_to_prewhere>1</optimize_move_to_prewhere>

            <!-- ── Aggregation: spill to disk late ── -->
            <max_bytes_before_external_group_by>17179869184</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>17179869184</max_bytes_before_external_sort>
            <group_by_two_level_threshold>100000</group_by_two_level_threshold>
            <group_by_two_level_threshold_bytes>50000000</group_by_two_level_threshold_bytes>

            <!-- ── ReplacingMergeTree ── -->
            <do_not_merge_across_partitions_select_final>1</do_not_merge_across_partitions_select_final>
        </default>
    </profiles>
</clickhouse>
