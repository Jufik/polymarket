# ── Docker Compose Ports ──────────────────────────────────────────────
# These document the host-side port mappings in docker-compose.yml.
# Change here AND in docker-compose.yml if you need different ports.

CLICKHOUSE_HTTP_PORT=18123
CLICKHOUSE_NATIVE_PORT=19000
CH_UI_PORT=15521
POSTGRES_PORT=15432
MLFLOW_PORT=5050
REDPANDA_KAFKA_PORT=19092
REDPANDA_PROXY_PORT=18082
REDPANDA_CONSOLE_PORT=18080

# ── Live Pipeline (PM_ prefix, read by pydantic-settings) ───────────
# Polygon RPC WebSocket — comma-separated list for multi-endpoint redundancy
# Races all endpoints in parallel; first to deliver wins, duplicates dropped.
# Free defaults are built-in (publicnode, drpc, tenderly). Add paid endpoints for reliability.
# Legacy PM_RPC_WS_URL / PM_ALCHEMY_WS_URL still work via AliasChoices.
PM_RPC_WS_URLS=wss://polygon-bor-rpc.publicnode.com,wss://polygon.drpc.org,wss://polygon.gateway.tenderly.co,wss://polygon-mainnet.infura.io/ws/v3/YOUR_INFURA_KEY
# PM_RESOLUTION_RPC_ENABLED=true  # on-chain resolution detection (default: true)

# Required: PostgreSQL DSN (credentials for local Docker instance)
PM_PG_DSN=postgresql://polymarket:polymarket@localhost:15432/polymarket

# Defaults (uncomment to override)
# PM_REDPANDA_URL=localhost:19092
# PM_CH_HOST=localhost
# PM_CH_PORT=18123
# PM_CH_DATABASE=polymarket

# Dashboard
# PM_DASHBOARD_REFRESH_S=5
# PM_DASHBOARD_PORT=8099
